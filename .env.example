# Supabase lokal (`supabase start`), port DB dari supabase/config.toml
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Supabase Storage untuk lampiran (bucket privat). Ambil dari `supabase status`
# (lokal) atau Dashboard > Project Settings > API (cloud).
# Service role key HANYA dipakai di server — jangan pernah beri prefix NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# Fallback bila Supabase Storage tidak dikonfigurasi (dev/test saja; tidak persisten di serverless)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
